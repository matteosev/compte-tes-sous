<div class="card mb-0">
    <div class="playing-card is-unselectable">
        <!-- TODO: styliser la playing-card -->
        @Label
    </div>
    <div class="has-text-centered is-unselectable">
        @Count
    </div>

    <div class="card-footer">
        <div class="card-footer-item">
            <span @onclick="Decrement" class="material-symbols-outlined is-clickable is-unselectable @(IsMin() ? "disabled-button" : "")">remove</span>
        </div>
        <div class="card-footer-item">
            <span @onclick="Increment" class="material-symbols-outlined is-clickable is-unselectable @(IsMax() ? "disabled-button" : "")">add</span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Label { get; set; } = "";

    [Parameter]
    public int Count { get; set; }

    [Parameter]
    public int MaxCount { get; set; }

    [Parameter]
    public EventCallback<int> CountChanged { get; set; }

    private async Task Decrement()
    {
        if (IsMin())
            return;

        Count--;
        await CountChanged.InvokeAsync(Count);
    }

    private async Task Increment()
    {
        if (IsMax())
            return;

        Count++;
        await CountChanged.InvokeAsync(Count);
    }

    private bool IsMin()
    {
        return Count <= 0;
    }

    private bool IsMax()
    {
        return Count >= MaxCount;
    }
}

<style>
    .playing-card {
        width: 100%;
        aspect-ratio: 1/1.5;
        border: 1px solid #000;
        border-radius: 5px;
        background-color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 24px;
        color: black;
        border-color: transparent;
    }

    .disabled-button {
        opacity: 0.1;
    }
</style>
